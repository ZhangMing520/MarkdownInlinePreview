{
    // 渲染引擎："python-markdown"（默认）| "markdown-it-py"（v0.2 起可选）
    "engine": "python-markdown",

    // 传给 python-markdown 的扩展开关（GFM 表格/代码块/严谨列表/属性/list 内 html）
    // codehilite 借助 pygments 做代码高亮（依赖已声明）
    // 注意：tables 覆盖 GFM 表格；但任务列表(- [ ])与删除线(~~x~~)默认扩展不支持，
    // 需额外扩展（手写极小扩展或 vendor pymdown-extensions 子集，见 plan.md 依赖策略）
    "extensions": [
        "tables",
        "fenced_code",
        "sane_lists",
        "attr_list",
        "md_in_html",
        "codehilite"
    ],

    // 刷新防抖毫秒数
    "refresh_delay_ms": 300,

    // 光标移动时同步滚动预览
    "sync_scroll": true
}
