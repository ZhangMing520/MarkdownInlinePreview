{
    // 渲染引擎："python-markdown"（默认）| "markdown-it-py"（v0.2 起可选）
    "engine": "python-markdown",

    // 传给 python-markdown 的扩展开关
    // - tables/fenced_code/sane_lists/attr_list/md_in_html：GFM 表格/围栏代码块/严谨列表/属性/list 内 html
    // - codehilite：pygments 代码高亮（依赖已声明）
    // - toc：给标题生成 id（预览内点 #锚点 链接跳转依赖它）
    // - pymdownx.tasklist / pymdownx.tilde：vendored pymdownx 子集，补任务列表(- [ ])与删除线(~~x~~)
    "extensions": [
        "tables",
        "fenced_code",
        "sane_lists",
        "attr_list",
        "md_in_html",
        "codehilite",
        "toc",
        "pymdownx.tasklist",
        "pymdownx.tilde"
    ],

    // 刷新防抖毫秒数
    "refresh_delay_ms": 300,

    // 光标移动（点击/方向键/打字）时同步滚动预览。
    // 注意跟随的是光标而非滚轮：Sublime 未向插件暴露视图滚动事件，滚轮/拖滚动条不触发
    "sync_scroll": true,

    // 内嵌预览多标签：左栏切换源文件标签时，右栏自动切到对应的预览标签。
    // false 时右栏停在手动选择的预览标签上（各预览仍各自实时刷新）
    "preview_tab_follows_source": true,

    // 浏览器实时预览：启用 KaTeX 数学公式与 mermaid 图（JS 已 vendor 进包，离线可用）
    "browser_extras": true
}
